generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Board {
  id          String   @id @default(uuid())
  title       String
  key         String   @unique // JIRA-style key (e.g., "PROJ")
  description String?
  color       String   @default("#0079BF")
  cardCounter Int      @default(0) // Auto-increment counter for cards
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lists       List[]
}

model List {
  id        String   @id @default(uuid())
  title     String
  position  Int
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
}

model Card {
  id          String         @id @default(uuid())
  number      Int            // Card number within board (e.g., 123 in "PROJ-123")
  boardKey    String         // Denormalized board key for easy access
  title       String
  description String?
  position    Int
  priority    Priority       @default(MEDIUM)
  deadline    DateTime?
  listId      String
  list        List           @relation(fields: [listId], references: [id], onDelete: Cascade)
  labels      Label[]
  checklists  Checklist[]
  comments    Comment[]
  links       Link[]
  assignees   CardAssignee[]
  relationsFrom CardRelation[] @relation("CardRelationFrom")
  relationsTo   CardRelation[] @relation("CardRelationTo")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([boardKey, number]) // Ensure unique card numbers per board
  @@index([listId])
}

model Label {
  id        String   @id @default(uuid())
  name      String
  color     String
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([cardId])
}

model Checklist {
  id        String         @id @default(uuid())
  title     String
  cardId    String
  card      Card           @relation(fields: [cardId], references: [id], onDelete: Cascade)
  items     ChecklistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([cardId])
}

model ChecklistItem {
  id          String    @id @default(uuid())
  text        String
  completed   Boolean   @default(false)
  position    Int
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([checklistId])
}

model Comment {
  id        String   @id @default(uuid())
  text      String
  author    String?
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
}

model Link {
  id        String   @id @default(uuid())
  title     String?
  url       String
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([cardId])
}

model User {
  id        String         @id @default(uuid())
  name      String
  email     String?        @unique
  avatar    String?
  color     String         @default("#3B82F6")
  cards     CardAssignee[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model CardAssignee {
  id         String   @id @default(uuid())
  cardId     String
  userId     String
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([cardId, userId])
  @@index([cardId])
  @@index([userId])
}

model CardRelation {
  id         String       @id @default(uuid())
  type       RelationType // Type of relation (blocks, blocked_by, relates_to, duplicates, etc.)
  fromCardId String
  toCardId   String
  fromCard   Card         @relation("CardRelationFrom", fields: [fromCardId], references: [id], onDelete: Cascade)
  toCard     Card         @relation("CardRelationTo", fields: [toCardId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([fromCardId, toCardId, type]) // Prevent duplicate relations
  @@index([fromCardId])
  @@index([toCardId])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RelationType {
  BLOCKS       // This card blocks the other card
  BLOCKED_BY   // This card is blocked by the other card
  RELATES_TO   // General relation
  DUPLICATES   // This card duplicates the other
  CLONES       // This card clones the other
}
