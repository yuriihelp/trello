[Unit]
Description=Trello Backend Service (Production)
After=network.target trello-postgres.service
Requires=trello-postgres.service

[Service]
Type=simple
User=root
WorkingDirectory=/trello/backend
Environment="NODE_ENV=production"
Environment="DATABASE_URL=postgresql://trello:trello_password@localhost:5432/trello?schema=public"
Environment="PORT=3223"

# PRODUCTION build must be used — dist/index.js
ExecStart=/usr/bin/node /trello/backend/dist/index.js

Restart=always
RestartSec=5

StandardOutput=append:/var/log/trello-backend.log
StandardError=append:/var/log/trello-backend.log

[Install]
WantedBy=multi-user.target
