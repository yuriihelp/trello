[Unit]
Description=Trello Frontend Service
After=network.target trello-backend.service
Wants=trello-backend.service

[Service]
Type=simple
User=root
WorkingDirectory=/trello/frontend
Environment="NODE_ENV=production"
ExecStart=/usr/bin/npm run dev
Restart=always
RestartSec=10
StandardOutput=append:/var/log/trello-frontend.log
StandardError=append:/var/log/trello-frontend.log

[Install]
WantedBy=multi-user.target
